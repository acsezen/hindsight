index 000000000..028b7be91
--- /dev/null
+++ b/client/src/data-provider/Hindsight.ts
@@ -0,0 +1,87 @@
+import { Constants, MutationKeys, QueryKeys, dataService } from 'librechat-data-provider';
+import { useIsMutating, useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import type {
+  THindsightConsent,
+  THindsightAvailability,
+  THindsightConsentUpdate,
+} from 'librechat-data-provider';
+import type { QueryClient } from '@tanstack/react-query';
+import type { useStore } from 'jotai';
+import { hindsightAcknowledgedAtom } from '~/store/hindsight';
+
+const consentKey = (conversationId: string) => [QueryKeys.hindsightConsent, conversationId];
+const consentMutationKey = (conversationId: string) => [
+  MutationKeys.updateHindsightConsent,
+  conversationId,
+];
+
+export function useHindsightAvailabilityQuery() {
+  return useQuery<THindsightAvailability>(
+    [QueryKeys.hindsightAvailability],
+    () => dataService.getHindsightAvailability(),
+    { staleTime: Infinity, refetchOnWindowFocus: false },
+  );
+}
+
+export function useHindsightConsentQuery(conversationId: string, enabled: boolean) {
+  return useQuery<THindsightConsent>(
+    consentKey(conversationId),
+    () => dataService.getHindsightConsent(conversationId),
+    { enabled: enabled && conversationId.length > 0, refetchOnWindowFocus: false },
+  );
+}
+
+/**
+ * The displayed state changes only from a server answer. Success cancels any
+ * read already in flight (an older answer must not overwrite the confirmed
+ * one) before writing it; failure refetches server truth. Both callbacks are
+ * awaited by the mutation, so it stays pending until reconciliation is done.
+ */
+export function useUpdateHindsightConsentMutation(conversationId: string) {
+  const queryClient = useQueryClient();
+  const queryKey = consentKey(conversationId);
+  return useMutation<THindsightConsentUpdate, unknown, boolean>(
+    consentMutationKey(conversationId),
+    (enabled) => dataService.updateHindsightConsent(conversationId, enabled),
+    {
+      onSuccess: async (data) => {
+        await queryClient.cancelQueries({ queryKey });
+        queryClient.setQueryData<THindsightConsent>(queryKey, {
+          available: true,
+          enabled: data.enabled,
+        });
+      },
+      onError: () => queryClient.invalidateQueries({ queryKey }),
+    },
+  );
+}
+
+/** True while any control's change for this chat is unconfirmed or reconciling. */
+export function useHindsightConsentChanging(conversationId: string): boolean {
+  return useIsMutating({ mutationKey: consentMutationKey(conversationId) }) > 0;
+}
+
+/**
+ * The send-time check: a rendered control showed On for this chat, no change
+ * from any control is still in flight, and, for an existing chat, the cached
+ * state is a successful, current server answer. A failed or invalidated read
+ * never counts, even when an older On is still cached. Read synchronously
+ * from the stores, so a send cannot slip in before the badge re-renders.
+ */
+export function isHindsightAcknowledged(
+  jotai: ReturnType<typeof useStore>,
+  queryClient: QueryClient,
+  conversationId: string,
+): boolean {
+  if (jotai.get(hindsightAcknowledgedAtom) !== conversationId) {
+    return false;
+  }
+  if (queryClient.isMutating({ mutationKey: consentMutationKey(conversationId) }) > 0) {
+    return false;
+  }
+  if (conversationId === Constants.NEW_CONVO) {
+    return true;
+  }
+  const state = queryClient.getQueryState(consentKey(conversationId));
+  return state?.status === 'success' && !state.isInvalidated;
+}
diff --git a/client/src/hooks/Hindsight/useHindsightConsent.ts b/client/src/hooks/Hindsight/useHindsightConsent.ts
new file mode 100644
index 000000000..4af477cd7
--- /dev/null
+++ b/client/src/hooks/Hindsight/useHindsightConsent.ts
@@ -0,0 +1,121 @@
+import { useCallback } from 'react';
+import { useAtom } from 'jotai';
+import { useRecoilValue } from 'recoil';
+import { useToastContext } from '@librechat/client';
+import {
+  Constants,
+  AgentCapabilities,
+  isAgentsEndpoint,
+  isAssistantsEndpoint,
+} from 'librechat-data-provider';
+import {
+  useGetAgentByIdQuery,
+  useHindsightConsentQuery,
+  useHindsightConsentChanging,
+  useHindsightAvailabilityQuery,
+  useUpdateHindsightConsentMutation,
+} from '~/data-provider';
+import { hindsightDraftAtom } from '~/store/hindsight';
+import { useGetAgentsConfig, useLocalize } from '~/hooks';
+import store from '~/store';
+
+/** The Tool Library entry that makes a saved agent Hindsight-capable. */
+const HINDSIGHT_TOOL = 'hindsight';
+
+/** Which composer surface an endpoint is: saved agents, plain model chats, or unsupported. */
+export function hindsightKind(endpoint?: string | null): HindsightSurface['kind'] {
+  if (!endpoint || isAssistantsEndpoint(endpoint)) {
+    return null;
+  }
+  return isAgentsEndpoint(endpoint) ? 'agent' : 'model';
+}
+
+export interface HindsightSurface {
+  conversationId?: string | null;
+  /** `model` for plain model chats, `agent` for saved agents, null where unsupported. */
+  kind: 'model' | 'agent' | null;
+  agentId?: string | null;
+  /** Model specs that hide the badge row never show the control. */
+  hidden: boolean;
+}
+
+/**
+ * Per-chat Hindsight state for the composer. Existing chats show only the
+ * server-confirmed value; a new chat holds its own in-memory draft until its
+ * first message. The server makes the final decision either way.
+ */
+export default function useHindsightConsent({
+  conversationId,
+  kind,
+  agentId,
+  hidden,
+}: HindsightSurface) {
+  const localize = useLocalize();
+  const { showToast } = useToastContext();
+  const isTemporary = useRecoilValue(store.isTemporary);
+  const isSubmitting = useRecoilValue(store.anySubmittingSelector);
+  const key = conversationId || Constants.NEW_CONVO;
+  const isNew = key === Constants.NEW_CONVO;
+  const availability = useHindsightAvailabilityQuery();
+  const available = availability.data?.available === true;
+  const eligible = available && kind != null && !hidden && !isTemporary;
+  const agent = useGetAgentByIdQuery(agentId, {
+    enabled: eligible && kind === 'agent' && !!agentId,
+  });
+  const { agentsConfig } = useGetAgentsConfig();
+  /** Like a plugin, the agent entry follows the `tools` capability; the server applies the same gate. */
+  const toolsEnabled = agentsConfig?.capabilities?.includes(AgentCapabilities.tools) === true;
+  const capable =
+    kind === 'agent' ? toolsEnabled && agent.data?.tools?.includes(HINDSIGHT_TOOL) === true : true;
+  const supported = eligible && capable;
+  const consent = useHindsightConsentQuery(key, supported && !isNew);
+  const mutation = useUpdateHindsightConsentMutation(key);
+  /** Shared by every control: a change started from the Tools menu also holds the badge. */
+  const changing = useHindsightConsentChanging(key);
+  const [draft, setDraft] = useAtom(hindsightDraftAtom);
+
+  const shown = supported && (isNew || consent.data?.available === true);
+  const enabled = isNew ? draft : consent.data?.enabled === true;
+  /** A failed read leaves only an older cached answer: never treat it as confirmed. */
+  const unconfirmed = !isNew && consent.isError;
+  const pending = !isNew && (changing || consent.data == null || unconfirmed);
+
+  const setEnabled = useCallback(
+    (value: boolean) => {
+      /** The server refuses changes during a run; the controls do not offer one. */
+      if (isSubmitting) {
+        return;
+      }
+      /** After a failed read, a click asks the server again instead of changing anything. */
+      if (unconfirmed && !changing) {
+        void consent.refetch();
+        return;
+      }
+      if (pending) {
+        return;
+      }
+      if (isNew) {
+        setDraft(value);
+        return;
+      }
+      mutation.mutate(value, {
+        onError: () =>
+          showToast({ message: localize('com_ui_hindsight_update_error'), status: 'error' }),
+      });
+    },
+    [
+      isNew,
+      consent,
+      pending,
+      changing,
+      mutation,
+      setDraft,
+      localize,
+      showToast,
+      unconfirmed,
+      isSubmitting,
+    ],
+  );
+
+  return { key, shown, enabled, pending, unconfirmed, isSubmitting, setEnabled };
+}
